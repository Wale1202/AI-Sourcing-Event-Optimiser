# Copy to .env to override docker-compose defaults. The defaults already work
# out of the box, so this file exists mainly to document what's tweakable.

# --- Postgres (db service) ---
POSTGRES_USER=sourcing
POSTGRES_PASSWORD=sourcing
POSTGRES_DB=sourcing

# --- Frontend build-time API URL ---
# Browser-facing URL — must be reachable from your machine, not from inside
# Docker. Change this if you map the backend to a different host port.
VITE_API_URL=http://localhost:8000
